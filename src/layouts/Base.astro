---
import Barra from '../components/Barra.astro';
import { sitio } from '../data/sitio';
import { url } from '../lib/url';
import '../styles/global.css';

interface Props {
  titulo?: string;
  descripcion?: string;
  barra?: boolean; // muestra la barra lateral
}

const { titulo, descripcion = sitio.lema, barra = true } = Astro.props;
const ruta = Astro.url.pathname.replace(/\/$/, '');
const inicio = url().replace(/\/$/, '');

const menu = [
  { href: url(), texto: 'Inicio', activo: ruta === inicio },
  { href: url('acerca'), texto: 'Acerca del blog', activo: ruta === url('acerca') },
  { href: url('referencias'), texto: 'Referencias', activo: ruta === url('referencias') },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descripcion} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,600;1,7..72,400&family=Schibsted+Grotesk:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{titulo ? `${titulo} · ${sitio.nombre}` : `${sitio.nombre} · Blog de ${sitio.curso}, UMG`}</title>
  </head>
  <body>
    <header class="cabecera">
      <div class="envoltura cabecera-in">
        <a class="marca" href={url()}>
          <img src={url('img/logo-umg.png')} alt="Escudo de la Universidad Mariano Gálvez de Guatemala" width="72" height="72" />
          <span>
            <span class="nombre">{sitio.nombre}</span>
            <span class="lema">{sitio.lema}</span>
          </span>
        </a>
        <p class="institucion">
          {sitio.universidad}<br />
          {sitio.facultad} · {sitio.programa}<br />
          Curso: {sitio.curso} · Sección {sitio.seccion} · {sitio.ciclo}
        </p>
      </div>
    </header>

    <nav class="menu" aria-label="Principal">
      <ul class="envoltura">
        {
          menu.map((m) => (
            <li>
              <a href={m.href} aria-current={m.activo ? 'page' : undefined}>
                {m.texto}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class:list={['envoltura', 'cuerpo', { 'con-barra': barra }]}>
      <main>
        <slot />
      </main>
      {barra && <Barra />}
    </div>

    <footer class="pie">
      <div class="envoltura pie-in">
        <p>
          <strong>{sitio.nombre}</strong> · {sitio.universidad} · {sitio.programa} · {sitio.curso}, sección {sitio.seccion} · {sitio.ciclo}
        </p>
        <p>Fotografías de Unsplash, con crédito en cada entrada. Citas y referencias en formato APA 7.ª edición.</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .cabecera {
    background: var(--rojo);
    color: oklch(1 0 0);
    padding: 1.5rem 0;
  }
  .cabecera-in {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
  }
  .marca {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: inherit;
    text-decoration: none;
  }
  .marca img { width: 72px; height: 72px; flex: none; }
  .marca > span { display: flex; flex-direction: column; }
  .nombre {
    font-family: var(--titulos);
    font-weight: 800;
    font-size: var(--paso-3);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .lema {
    font-size: var(--paso--1);
    margin-top: 0.4rem;
    opacity: 0.92;
    max-width: 44ch;
  }
  .institucion {
    margin: 0;
    font-family: var(--titulos);
    font-size: var(--paso--1);
    line-height: 1.45;
    text-align: right;
    opacity: 0.92;
  }

  .menu {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    background: var(--superficie);
    border-bottom: 1px solid var(--borde);
  }
  .menu ul {
    list-style: none;
    margin: 0 auto;
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .menu a {
    display: block;
    padding: 0.85rem 0;
    font-family: var(--titulos);
    font-weight: 600;
    font-size: var(--paso--1);
    color: var(--suave);
    text-decoration: none;
    white-space: nowrap;
    border-bottom: 3px solid transparent;
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .menu a:hover { color: var(--tinta); }
  .menu a[aria-current='page'] { color: var(--tinta); border-bottom-color: var(--rojo); }

  .cuerpo { padding-top: 2.5rem; padding-bottom: 4rem; }
  main { min-width: 0; }
  @media (min-width: 60rem) {
    .con-barra {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 17rem;
      gap: 4rem;
      align-items: start;
    }
  }
  @media (max-width: 59.99rem) {
    .con-barra :global(.barra) { margin-top: 4rem; }
  }
  @media (max-width: 40rem) {
    .institucion { text-align: left; }
    .marca img { width: 56px; height: 56px; }
  }

  .pie {
    border-top: 1px solid var(--borde);
    padding: 2rem 0 2.5rem;
    font-family: var(--titulos);
    font-size: var(--paso--1);
    color: var(--suave);
  }
  .pie p { margin: 0 0 0.4rem; }
</style>
