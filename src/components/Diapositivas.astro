---
// Visor de la presentación de clase: carrusel con desplazamiento y botones.
import { diapositivas } from '../data/sitio';
import { url } from '../lib/url';

const total = diapositivas.length;
---

<figure class="visor" data-visor>
  <div class="pista" tabindex="0" aria-label="Diapositivas de la presentación. Usa las flechas para avanzar." data-pista>
    {
      diapositivas.map((d, i) => (
        <img
          src={url(`img/presentacion/${d.src}`)}
          alt={`Diapositiva ${i + 1} de ${total}. ${d.alt}`}
          width="1600"
          height="900"
          loading={i < 2 ? 'eager' : 'lazy'}
          decoding="async"
        />
      ))
    }
  </div>
  <div class="controles">
    <button type="button" data-ant aria-label="Diapositiva anterior">←</button>
    <span aria-live="polite" data-cuenta>1 / {total}</span>
    <button type="button" data-sig aria-label="Diapositiva siguiente">→</button>
  </div>
  <figcaption>Presentación del Grupo 6 utilizada en la exposición de clase.</figcaption>
</figure>

<script>
  for (const visor of document.querySelectorAll<HTMLElement>('[data-visor]')) {
    const pista = visor.querySelector<HTMLElement>('[data-pista]')!;
    const cuenta = visor.querySelector<HTMLElement>('[data-cuenta]')!;
    const total = pista.children.length;
    const actual = () => Math.round(pista.scrollLeft / pista.clientWidth);
    const ir = (i: number) => {
      const destino = Math.max(0, Math.min(total - 1, i));
      const suave = !matchMedia('(prefers-reduced-motion: reduce)').matches;
      pista.scrollTo({ left: destino * pista.clientWidth, behavior: suave ? 'smooth' : 'auto' });
    };
    visor.querySelector('[data-ant]')!.addEventListener('click', () => ir(actual() - 1));
    visor.querySelector('[data-sig]')!.addEventListener('click', () => ir(actual() + 1));
    pista.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); ir(actual() + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); ir(actual() - 1); }
    });
    pista.addEventListener('scroll', () => { cuenta.textContent = `${actual() + 1} / ${total}`; }, { passive: true });
  }
</script>

<style>
  .visor { margin: 2.5rem 0; max-width: 68ch; }
  .pista {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    border-radius: 6px;
    background: oklch(0.15 0 0);
    aspect-ratio: 16 / 9;
  }
  .pista::-webkit-scrollbar { display: none; }
  .pista img { flex: 0 0 100%; width: 100%; height: 100%; object-fit: contain; scroll-snap-align: start; }
  .controles {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 0.75rem;
    font-family: var(--titulos);
    font-size: var(--paso--1);
    font-variant-numeric: tabular-nums;
    color: var(--suave);
  }
  button {
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--borde);
    border-radius: 50%;
    background: var(--superficie);
    color: var(--tinta);
    font-size: 1.1rem;
    cursor: pointer;
    transition: border-color 0.2s var(--ease), background-color 0.2s var(--ease);
  }
  button:hover { border-color: var(--tinta); background: var(--tenue); }
  figcaption { text-align: center; margin-top: 0.5rem; font-family: var(--titulos); font-size: var(--paso--1); color: var(--suave); }
</style>
