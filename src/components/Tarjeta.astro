---
// Entrada en el listado del blog.
import Firma from './Firma.astro';
import Etiquetas from './Etiquetas.astro';
import { url } from '../lib/url';
import type { Post } from '../lib/posts';

interface Props {
  post: Post;
  destacada?: boolean;
}

const { post, destacada = false } = Astro.props;
const { titulo, resumen, portada, etiquetas } = post.data;
const href = url(post.id);
---

<article class:list={['tarjeta', { destacada }]}>
  <a class="foto" href={href} tabindex="-1" aria-hidden="true">
    <img
      src={url(portada.src)}
      alt=""
      width="1600"
      height="900"
      loading={destacada ? 'eager' : 'lazy'}
      decoding="async"
    />
  </a>
  <div class="texto">
    {destacada && <p class="fijada">Entrada fijada · Empieza aquí</p>}
    <Etiquetas etiquetas={etiquetas} />
    <h3><a href={href}>{titulo}</a></h3>
    <p class="resumen">{resumen}</p>
    <Firma post={post} tam={32} />
  </div>
</article>

<style>
  .tarjeta {
    display: grid;
    gap: 1rem 1.75rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--borde);
  }
  @media (min-width: 40rem) {
    .tarjeta:not(.destacada) { grid-template-columns: 15rem minmax(0, 1fr); align-items: start; }
  }

  .foto { display: block; overflow: hidden; border-radius: 6px; aspect-ratio: 16 / 10; background: var(--tenue); }
  .foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }
  .tarjeta:hover .foto img { transform: scale(1.04); }

  .texto { display: flex; flex-direction: column; gap: 0.6rem; min-width: 0; }
  h3 { font-size: var(--paso-1); margin: 0; }
  h3 a { color: var(--tinta); text-decoration: none; }
  h3 a:hover { text-decoration: underline; text-decoration-thickness: 2px; }
  .resumen { margin: 0 0 0.4rem; color: var(--suave); }

  .destacada { padding-top: 0; }
  .destacada .foto { aspect-ratio: 16 / 8; }
  .destacada h3 { font-size: var(--paso-3); letter-spacing: -0.025em; }
  .destacada .resumen { font-size: var(--paso-1); line-height: 1.5; }
  .fijada {
    margin: 0.25rem 0 0;
    font-family: var(--titulos);
    font-weight: 700;
    font-size: var(--paso--1);
    color: var(--rojo);
  }
  @media (prefers-color-scheme: dark) {
    .fijada { color: oklch(0.78 0.11 27); }
  }
</style>
