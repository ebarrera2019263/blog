---
// Línea de autor, fecha y tiempo de lectura de una entrada.
import Avatar from './Avatar.astro';
import { autores } from '../data/sitio';
import { url } from '../lib/url';
import { fechaLarga, minutosDeLectura, type Post } from '../lib/posts';

interface Props {
  post: Post;
  tam?: number;
}

const { post, tam = 36 } = Astro.props;
const { autor, fecha } = post.data;
---

<div class="firma">
  <Avatar autor={autor} tam={tam} />
  <p>
    <a class="nombre" href={url(`autores/${autor}`)}>{autores[autor].nombre}</a>
    <span class="datos">
      <time datetime={fecha.toISOString().slice(0, 10)}>{fechaLarga(fecha)}</time>{' · '}{minutosDeLectura(post)} min de lectura
    </span>
  </p>
</div>

<style>
  .firma { display: flex; align-items: center; gap: 0.7rem; font-family: var(--titulos); font-size: var(--paso--1); }
  p { margin: 0; line-height: 1.35; display: flex; flex-direction: column; }
  .nombre { color: var(--tinta); font-weight: 700; text-decoration: none; }
  .nombre:hover { text-decoration: underline; }
  .datos { color: var(--suave); }
</style>
