---
import Base from '../layouts/Base.astro';
import Tarjeta from '../components/Tarjeta.astro';
import { obtenerPosts } from '../lib/posts';

const posts = await obtenerPosts();
const fijada = posts.find((p) => p.data.fijada);
const resto = posts.filter((p) => p !== fijada);
---

<Base>
  {fijada && <Tarjeta post={fijada} destacada />}

  <section aria-labelledby="recientes" id="entradas">
    <h2 id="recientes">Entradas recientes</h2>
    {resto.map((p) => <Tarjeta post={p} />)}
  </section>
</Base>

<style>
  h2 {
    font-size: var(--paso-1);
    margin: 3rem 0 0;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--tinta);
  }
</style>
